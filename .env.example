# Base URL of the backend API. Read in src/lib/env.ts.
VITE_BACKEND_URL=https://dpa-api.2devs.net

# Only VITE_-prefixed vars are exposed to the browser, and every one of them is
# inlined into the built bundle — never put a secret here. The Start template's
# SESSION_SECRET_KEY / SESSION_COOKIE_NAME / SESSION_MAX_AGE_DAYS were server-only
# and have no place in a SPA.
